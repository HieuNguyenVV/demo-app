{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fileName",
    "format",
    "mimeType",
    "contentEncoding",
    "sizeBytes",
    "txtFileName",
    "txtMimeType",
    "txtSizeBytes",
    "participantCount",
    "messageCount",
    "summary",
    "content",
    "txtContent"
  ],
  "properties": {
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Downloadable draw.io file name ending in .drawio."
    },
    "format": {
      "type": "string",
      "enum": ["drawio"]
    },
    "mimeType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "contentEncoding": {
      "type": "string",
      "enum": ["text"]
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "txtFileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Downloadable SequenceDiagram.org source file ending in .txt."
    },
    "txtMimeType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "txtSizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "participantCount": {
      "type": "integer",
      "minimum": 2
    },
    "messageCount": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500000,
      "description": "draw.io mxfile XML."
    },
    "txtContent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50000,
      "description": "SequenceDiagram.org source text."
    },
    "previewSvg": {
      "type": "string",
      "maxLength": 80000,
      "description": "Renderer-only SVG preview of the sequence diagram."
    },
    "_sota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelProjection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "omitKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
