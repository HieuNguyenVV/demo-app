{
  "type": "object",
  "additionalProperties": false,
  "required": ["fileName", "participants", "messages"],
  "properties": {
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Base file name without extension, for example login-sequence."
    },
    "title": {
      "type": "string",
      "maxLength": 80,
      "description": "Optional diagram heading. Vietnamese is fine."
    },
    "participants": {
      "description": "Actors and systems as lifelines, left to right. Native JSON array preferred; a JSON array string is also accepted.",
      "oneOf": [
        { "$ref": "#/$defs/participantList" },
        { "type": "string", "minLength": 2, "maxLength": 8000 }
      ]
    },
    "messages": {
      "description": "Calls in time order, top to bottom. Native JSON array preferred; a JSON array string is also accepted.",
      "oneOf": [
        { "$ref": "#/$defs/messageList" },
        { "type": "string", "minLength": 2, "maxLength": 12000 }
      ]
    }
  },
  "$defs": {
    "participantList": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable id, for example user or api."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Short lifeline name, 1 to 4 words."
          }
        }
      }
    },
    "messageList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 48,
            "description": "Short call name, for example POST /login."
          },
          "kind": {
            "type": "string",
            "enum": ["sync", "async", "return", "self"],
            "description": "sync = solid call, async = open arrow, return = dashed reply, self = loop on the same lifeline. Default sync."
          }
        }
      }
    }
  }
}
