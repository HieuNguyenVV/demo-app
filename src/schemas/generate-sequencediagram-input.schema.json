{
  "type": "object",
  "additionalProperties": false,
  "required": ["fileName", "participants", "messages"],
  "properties": {
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Base file name without extension, for example login-sequence."
    },
    "title": {
      "type": "string",
      "maxLength": 80,
      "description": "Optional diagram heading. Vietnamese is fine."
    },
    "participants": {
      "description": "Actors and systems as lifelines, left to right. Native JSON array preferred; a JSON array string is also accepted.",
      "oneOf": [
        { "$ref": "#/$defs/participantList" },
        { "type": "string", "minLength": 2, "maxLength": 8000 }
      ]
    },
    "messages": {
      "description": "Time-ordered steps: calls and common markers (alt/else/loop/opt/par/break/note/activate). Native JSON array preferred; a JSON array string is also accepted.",
      "oneOf": [
        { "$ref": "#/$defs/messageList" },
        { "type": "string", "minLength": 2, "maxLength": 16000 }
      ]
    }
  },
  "$defs": {
    "participantList": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable id, for example user or api."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Short lifeline name, 1 to 4 words."
          }
        }
      }
    },
    "messageList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/call" },
          { "$ref": "#/$defs/fragment" }
        ]
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["message"]
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 48,
          "description": "Short call name, for example POST /login."
        },
        "kind": {
          "type": "string",
          "enum": ["sync", "async", "return", "self"],
          "description": "sync = solid call, async = open arrow, return = dashed reply, self = loop on the same lifeline. Default sync."
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["alt", "else", "loop", "opt", "par", "break", "end", "note", "activate", "deactivate"],
          "description": "alt/else/end = if/else. loop/end = repeat. opt/end = optional. par/else/end = parallel. break/end = exception path. note = comment over lifelines. activate/deactivate = execution bar. Close every alt/loop/opt/par/break with end."
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Required for note, activate, and deactivate."
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Optional second lifeline for note. Defaults to from."
        },
        "label": {
          "type": "string",
          "maxLength": 48,
          "description": "Condition, note text, or branch name. Ignored on end/activate/deactivate."
        }
      }
    }
  }
}
