{
  "type": "object",
  "additionalProperties": false,
  "required": ["fileName", "nodes", "edges"],
  "properties": {
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "description": "Base file name without extension, for example checkout-flow."
    },
    "title": {
      "type": "string",
      "maxLength": 80,
      "description": "Optional diagram page name shown in draw.io."
    },
    "direction": {
      "type": "string",
      "enum": ["top-down", "left-right"],
      "description": "Layout direction. Use top-down for flowcharts with decisions; left-right for pipelines and sequences."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "Boxes on the diagram. ids must be unique and match edge from/to.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Stable node id, for example start or payment."
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Short text inside the shape. Prefer 1 to 6 words so the box stays readable."
          },
          "kind": {
            "type": "string",
            "enum": ["process", "decision", "start", "end", "data"],
            "description": "Use start and end for terminals, decision for yes/no diamonds, data for documents/records, process for steps. Default process."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 80,
      "description": "Connectors between node ids.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Source node id."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Target node id."
          },
          "label": {
            "type": "string",
            "maxLength": 40,
            "description": "Optional connector label, for example yes or no."
          }
        }
      }
    }
  }
}
