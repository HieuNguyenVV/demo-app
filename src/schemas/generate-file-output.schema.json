{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fileName",
    "format",
    "mimeType",
    "contentEncoding",
    "sizeBytes",
    "lineCount",
    "summary",
    "content"
  ],
  "properties": {
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "format": {
      "type": "string",
      "enum": ["txt", "md", "json", "csv", "pdf"]
    },
    "mimeType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "contentEncoding": {
      "type": "string",
      "enum": ["text", "base64"]
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 1
    },
    "lineCount": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500000
    },
    "_sota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelProjection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "omitKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
