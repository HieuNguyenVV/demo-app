# Local backend
PORT=8787
HOST=127.0.0.1

# VPS / Docker: use HOST=0.0.0.0 so the process accepts proxy traffic.
# HOST=0.0.0.0

# Sota Core API used to verify invocation JWTs (production).
SOTA_CORE_ORIGIN=https://api.v4.sotaagents.ai
SOTA_WEB_ORIGIN=https://app.sotaagents.ai

# After the backend is public over HTTPS, set manifest.yaml service.baseUrl and
# health.url to that URL, then run: npm run build && sota deploy
#
# Smoke without JWT: GET /api/test and POST /api/test { "text": "hello world" }.
# Declared tool routes still require a Core invocation token.
